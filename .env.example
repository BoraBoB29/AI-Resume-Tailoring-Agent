# Required: your Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=your_api_key_here

# Optional: model used for tailoring and JD analysis
MISTRAL_MODEL=mistral-large-latest

# Optional: LaTeX engine used to compile the resume PDF ("pdflatex" or "tectonic")
LATEX_ENGINE=pdflatex

# Optional: per-request timeout, in milliseconds, for Mistral API calls
MISTRAL_TIMEOUT_MS=180000

# Optional: number of retry attempts for transient Mistral errors
# (timeouts, connection errors, HTTP 429, HTTP 5xx). 0 disables retries.
MISTRAL_MAX_RETRIES=3

# Optional: base backoff, in seconds, used between retries (exponential,
# capped at 8 seconds)
MISTRAL_RETRY_BACKOFF_SECONDS=1

# Optional: maximum number of tailoring attempts per resume generation.
# 1 (default) reproduces the original single-shot behavior. Set to 2 or 3
# to let the pipeline automatically re-prompt the LLM with specific
# feedback (unsupported claims, missing JD keywords, page overflow) and
# retry before giving up.
MAX_TAILOR_ITERATIONS=1
